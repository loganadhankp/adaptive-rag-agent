# Google Gemini (Primary / Recommended)
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: OpenAI (if using OpenAI models)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Anthropic (if using Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Tavily (for web search fallback when documents are missing)
TAVILY_API_KEY=your-tavily-api-key-here

# LLM Configuration (gemini, openai, anthropic)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVAL_RESULTS=4
RELEVANCE_THRESHOLD=0.7
ANSWER_QUALITY_THRESHOLD=80
MAX_RETRIES=2

# Storage
CHROMA_PERSIST_DIR=data/vector_db
CHROMA_COLLECTION_NAME=knowledge_base
SQLITE_DB_PATH=database/chat_history.db
DOCUMENTS_DIR=data/documents

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
